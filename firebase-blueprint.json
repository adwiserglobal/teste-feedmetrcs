{
  "entities": {
    "MarketInsight": {
      "title": "Market Insight",
      "description": "A saved market research report from the Studio",
      "type": "object",
      "properties": {
        "account_id": { "type": "string", "description": "The account that owns this insight" },
        "query": { "type": "string", "description": "The search query used to generate this insight" },
        "insights_data": { "type": "object", "description": "The raw JSON data from the AI analysis" },
        "metadata": { "type": "object", "description": "Optional metadata like search parameters" },
        "created_at": { "type": "string", "format": "date-time", "description": "When it was saved" }
      },
      "required": ["query", "insights_data", "created_at"]
    },
    "TrendReport": {
      "title": "Trend Report",
      "description": "Daily cached market trends analysis",
      "type": "object",
      "properties": {
        "analysis_type": { "type": "string", "description": "Format: trends_monitor" },
        "cache_key": { "type": "string", "description": "Unique key per day (e.g., trends_2024-05-18)" },
        "data": { "type": "object", "description": "The structured trends data" },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "required": ["cache_key", "data", "created_at"]
    },
    "CustomForm": {
      "title": "Custom Form",
      "description": "Definition of a feedback or research form",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fields": { "type": "array" },
        "styling": { "type": "object" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "FormResponse": {
      "title": "Form Response",
      "description": "A single submission for a custom form",
      "type": "object",
      "properties": {
        "form_id": { "type": "string" },
        "response_data": { "type": "object" },
        "submitted_at": { "type": "string", "format": "date-time" },
        "ip_address": { "type": "string" },
        "user_agent": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/insights_history/{insightId}": {
      "schema": "MarketInsight",
      "description": "Historical repository of user-generated insights"
    },
    "/ai_analysis_cache/{cacheId}": {
      "schema": "TrendReport",
      "description": "Cache for expensive AI computations like daily global trends"
    },
    "/custom_forms/{formId}": {
      "schema": "CustomForm",
      "description": "Customizable feedback and research forms"
    },
    "/form_responses/{responseId}": {
      "schema": "FormResponse",
      "description": "Responses submitted to custom forms"
    }
  }
}
